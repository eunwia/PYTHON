from os import system
system("cls")

try:
    n = int(input("Input (1..20): "))
    if n>0 and n<=20 :
        for i in range(1, n + 1):
            for j in range(1, n + 1):
                print(f"{i * j:3}", end=" ")
            print()  # <-- this makes a new line after each row
    else:
        print("Accept only 1 to 20")
except:
    print("Invalid input")
