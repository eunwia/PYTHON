mlist:list = [1,2,3,4,5,6,7,8]

def main()->None:
    print(mlist[-8]) 
    #slicing
    # output: 1
    
    print(mlist[0:])
    # output: [1, 2, 3, 4, 5, 6, 7, 8]

    print(mlist[2:7])
    # output: [3, 4, 5, 6, 7]
    
    print(mlist[-5:-1])
    # output: [4, 5, 6, 7]

    print(mlist[1::2])
    #display all even
    # output: [2, 4, 6, 8]

    print(mlist[0::2])
    #display all odd
    #output: [1, 3, 5, 7]

    print(mlist[::-1])
    #display in reverse
    #output: [8, 7, 6, 5, 4, 3, 2, 1]

if __name__=="__main__":
    main()
